    "query": "SELECT \n    posting_date AS \"Posting Date:Date:120\",\n    COUNT(name) AS \"Invoice Count:Int:120\",\n    SUM(grand_total) AS \"Total Sales:Currency:120\",\n    SUM(total_taxes_and_charges) AS \"Total Tax:Currency:120\",\n    SUM(net_total) AS \"Net Total:Currency:120\",\n    SUM(outstanding_amount) AS \"Outstanding Amount:Currency:120\"\nFROM \n    `tabPOS Invoice`\nWHERE \n    docstatus = 1\n    AND posting_date BETWEEN %(start_date)s AND %(end_date)s\n    AND (%(pos_profile)s IS NULL OR pos_profile = %(pos_profile)s)\n    AND (%(company)s IS NULL OR company = %(company)s)\nGROUP BY \n    posting_date\nORDER BY \n    posting_date ASC",
