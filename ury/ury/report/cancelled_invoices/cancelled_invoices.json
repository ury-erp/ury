    "prepared_report": 0,
    "query": "SELECT \n    name AS \"Invoice No:Link/POS Invoice:120\",\n    posting_date AS \"Posting Date:Date:100\",\n    customer_name AS \"Customer:Data:150\",\n    modified_by AS \"Cancelled By:Data:150\",\n    grand_total AS \"Grand Total:Currency:120\",\n    cancel_reason AS \"Reason:Data:200\"\nFROM \n    `tabPOS Invoice`\nWHERE \n    docstatus = 2\n    AND posting_date BETWEEN %(start_date)s AND %(end_date)s\n    AND (%(pos_profile)s IS NULL OR pos_profile = %(pos_profile)s)\n    AND (%(company)s IS NULL OR company = %(company)s)\nORDER BY \n    posting_date DESC, name ASC",
