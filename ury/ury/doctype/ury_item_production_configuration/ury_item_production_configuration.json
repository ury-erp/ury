   "fieldname": "scope_section",
   "fieldtype": "Section Break",
   "label": "Scope"
  },
  {
   "fieldname": "item",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Item",
   "options": "Item",
   "reqd": 1
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Department",
   "options": "URY Production Department"
  },
  {
   "fieldname": "scope_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Branch",
   "options": "Branch",
   "reqd": 1
  },
  {
   "description": "Needed for Pre-Produced and Made to Order. Optional for Direct Retail.",
   "fieldname": "production_unit",
   "fieldtype": "Link",
   "label": "Production Unit",
   "options": "URY Production Unit"
  },
  {
   "fieldname": "scope_column_2",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "fieldname": "active",
   "fieldtype": "Check",
   "label": "Active"
  },
  {
   "fieldname": "policy_section",
   "fieldtype": "Section Break",
   "label": "Production Policy"
  },
  {
   "description": "How availability is worked out: stock (Pre-Produced), recipe capacity (Made to Order), stock without a unit (Direct Retail), or from components (Bundle).",
   "fieldname": "production_policy",
   "fieldtype": "Select",
   "label": "Production Policy",
   "options": "PRE_PRODUCED\nMADE_TO_ORDER\nDIRECT_RETAIL\nBUNDLE"
  },
  {
   "fieldname": "bom",
   "fieldtype": "Link",
   "label": "BOM",
   "options": "BOM"
  },
  {
   "fieldname": "policy_column",
   "fieldtype": "Column Break"
  },
  {
   "default": "IN_HOUSE",
   "depends_on": "eval:doc.production_policy==\"PRE_PRODUCED\"",
   "description": "Pre-Produced items only. In House: made at this unit from a recipe. External Receipt: arrives finished from a central kitchen.",
   "fieldname": "sourcing_mode",
   "fieldtype": "Select",
   "label": "Sourcing Mode",
   "options": "IN_HOUSE\nEXTERNAL_RECEIPT"
  },
  {
   "depends_on": "eval:doc.production_policy==\"BUNDLE\"",
   "mandatory_depends_on": "eval:doc.production_policy==\"BUNDLE\"",
   "description": "The ERPNext Product Bundle whose children define the components of this combo item. Required when Production Policy is BUNDLE.",
   "fieldname": "product_bundle",
   "fieldtype": "Link",
   "label": "Product Bundle",
   "options": "Product Bundle"
  },
  {
   "fieldname": "warehouses_section",
   "fieldtype": "Section Break",
   "label": "Warehouses",
   "depends_on": "eval:doc.production_policy==\"DIRECT_RETAIL\" || doc.sourcing_mode==\"EXTERNAL_RECEIPT\""
  },
  {
   "depends_on": "eval:doc.production_policy==\"DIRECT_RETAIL\"",
   "fieldname": "direct_retail_warehouse",
   "fieldtype": "Link",
   "label": "Direct Retail Warehouse",
   "options": "Warehouse"
  },
  {
   "fieldname": "warehouses_column",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.sourcing_mode==\"EXTERNAL_RECEIPT\"",
   "description": "Where finished stock is received when it is produced off-site.",
   "fieldname": "external_receiving_warehouse",
   "fieldtype": "Link",
   "label": "External Receiving Warehouse",
   "options": "Warehouse"
  },
  {
   "fieldname": "sales_plan_section",
   "fieldtype": "Section Break",
   "label": "Sales Plan Control",
   "collapsible": 1
  },
  {
   "default": "1",
   "description": "On: the item needs an approved Sales Plan to be sellable. Off: availability follows stock or capacity only.",
   "fieldname": "controlled_by_sales_plan",
   "fieldtype": "Check",
   "label": "Controlled by Sales Plan"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.controlled_by_sales_plan==1",
   "description": "Allow selling beyond the planned quantity while stock or capacity lasts. Needs Controlled by Sales Plan.",
   "fieldname": "allow_over_plan_sale",
   "fieldtype": "Check",
   "label": "Allow Over-Plan Sale"
  },
  {
   "fieldname": "sales_plan_column",
   "fieldtype": "Column Break"
  },
  {
   "default": "Plan Available",
   "description": "Plan Available: normal checks. Always Available: sellable regardless of plan, stock or capacity. Stock Available: stock or capacity only, ignoring Sales Plans.",
   "fieldname": "availability_mode",
   "fieldtype": "Select",
   "label": "Availability Mode",
   "options": "Plan Available\nAlways Available\nStock Available"
  }
 ],
