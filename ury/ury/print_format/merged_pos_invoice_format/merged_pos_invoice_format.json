 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "\n<style>\n\t.print-format table, .print-format tr, \n\t.print-format td, .print-format div, .print-format p {\n\t\tfont-family: inherit;\n\t\tline-height: 1.5;\n\t}\n\t@media screen {\n\t\t.print-format {\n\t\t\tpadding: 0px;\n\t\t}\n\t}\n    .text-muted { color: #8d99a6; }\n    .table-bordered > thead > tr > th, .table-bordered > tbody > tr > td {\n        border-color: #d1d8dd;\n        vertical-align: middle;\n    }\n    .page-border {\n        border: 1px solid #d1d8dd;\n        padding: 30px;\n        border-radius: 4px;\n    }\n</style>\n\n<div class=\"page-border\">\n\n<div class=\"row\">\n    <div class=\"col-xs-6\">\n        <h2 style=\"margin-top: 0px;\">POS Invoice</h2>\n        <div class=\"text-muted\" style=\"font-size: 16px;\">{{ doc.name }}</div>\n    </div>\n</div>\n\n<br>\n<h4 class=\"text-center\">{{ doc.status | upper }}</h4>\n<hr style=\"border-top: 1px solid #d1d8dd;\">\n\n<div class=\"row\" style=\"margin-bottom: 20px;\">\n    <div class=\"col-xs-6\">\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Customer Name:</div><div class=\"col-xs-6\"><b>{{ doc.customer_name or '' }}</b></div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Mobile Number:</div><div class=\"col-xs-6\">{{ doc.mobile_number or '' }}</div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Update Billed Amount in Delivery Note:</div><div class=\"col-xs-6\">{{ '\u2713' if doc.update_billed_amount_in_delivery_note else '' }}</div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Order Type:</div><div class=\"col-xs-6\">{{ doc.order_type or '' }}</div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Waiter:</div><div class=\"col-xs-6\">{{ doc.waiter or '' }}</div></div>\n        <br><br>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Restaurant:</div><div class=\"col-xs-6\">{{ doc.restaurant or '' }}</div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Branch:</div><div class=\"col-xs-6\">{{ doc.branch or '' }}</div></div>\n    </div>\n    <div class=\"col-xs-6\">\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Date:</div><div class=\"col-xs-6\"><b>{{ frappe.utils.formatdate(doc.posting_date) }}</b></div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Payment Due Date:</div><div class=\"col-xs-6\">{{ frappe.utils.formatdate(doc.due_date) if doc.due_date else '' }}</div></div>\n        <br>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Pax:</div><div class=\"col-xs-6\">{{ doc.no_of_pax or '' }}</div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Cashier:</div><div class=\"col-xs-6\">{{ doc.cashier or '' }}</div></div>\n        <div class=\"row\" style=\"margin-bottom: 10px;\"><div class=\"col-xs-6 text-muted\">Invoice Created:</div><div class=\"col-xs-6\">{{ '\u2713' if doc.invoice_created else '' }}</div></div>\n    </div>\n</div>\n\n<table class=\"table table-bordered table-condensed\">\n    <thead>\n        <tr>\n            <th class=\"text-center\" style=\"width: 5%\">Sr</th>\n            <th style=\"width: 15%\">Item</th>\n            <th style=\"width: 15%\">Description</th>\n            <th class=\"text-right\" style=\"width: 8%\">Quantity</th>\n            <th class=\"text-center\" style=\"width: 8%\">Stock UOM</th>\n            <th class=\"text-center\" style=\"width: 8%\">UOM</th>\n            <th class=\"text-right\" style=\"width: 10%\">Discount Amount</th>\n            <th class=\"text-right\" style=\"width: 10%\">Distributed Discount Amount</th>\n            <th class=\"text-right\" style=\"width: 10%\">Rate</th>\n            <th class=\"text-right\" style=\"width: 11%\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.items %}\n        <tr>\n            <td class=\"text-center\">{{ loop.index }}</td>\n            <td>{{ row.item_code }}<br><span class=\"text-muted\">{{ row.item_name }}</span></td>\n            <td>{{ row.description or '' }}</td>\n            <td class=\"text-right\">{{ row.qty }}</td>\n            <td class=\"text-center\">{{ row.stock_uom or '' }}</td>\n            <td class=\"text-center\">{{ row.uom or '' }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"discount_amount\") }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"distributed_discount_amount\") }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"amount\") }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<div class=\"row\">\n    <div class=\"col-xs-6\"></div>\n    <div class=\"col-xs-6\">\n        <table class=\"table table-bordered\">\n            <tr><td class=\"text-right text-muted\" style=\"width: 50%\">Total Quantity</td><td class=\"text-right\" style=\"width: 50%\">{{ doc.total_qty }}</td></tr>\n            <tr><td class=\"text-right text-muted\">Net Total</td><td class=\"text-right\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n            <tr><td class=\"text-right text-muted\">Grand Total</td><td class=\"text-right\"><b>{{ doc.get_formatted(\"grand_total\") }}</b></td></tr>\n        </table>\n    </div>\n</div>\n\n{% if doc.custom_merged_pos_invoice %}\n<br>\n<h3 class=\"text-center\" style=\"margin-top: 30px;\">MERGED INVOICE: {{ doc.custom_merged_pos_invoice }}</h3>\n<hr style=\"border-top: 1px solid #d1d8dd;\">\n\n<table class=\"table table-bordered table-condensed\">\n    <thead>\n        <tr>\n            <th class=\"text-center\" style=\"width: 5%\">Sr</th>\n            <th style=\"width: 55%\">Item Name</th>\n            <th class=\"text-right\" style=\"width: 10%\">Quantity</th>\n            <th class=\"text-right\" style=\"width: 15%\">Rate</th>\n            <th class=\"text-right\" style=\"width: 15%\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.custom_merged_pos_invoice_details %}\n        <tr>\n            <td class=\"text-center\">{{ loop.index }}</td>\n            <td>{{ row.item_name }}</td>\n            <td class=\"text-right\">{{ row.qty }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"rate\") }}</td>\n            <td class=\"text-right\">{{ row.get_formatted(\"amount\") }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<div class=\"row\">\n    <div class=\"col-xs-6\"></div>\n    <div class=\"col-xs-6\">\n        <table class=\"table table-bordered\">\n            <tr><td class=\"text-right text-muted\" style=\"width: 50%\">Merged Grand Total</td><td class=\"text-right\" style=\"width: 50%\"><b>{{ frappe.utils.fmt_money((doc.custom_merged_total | round) if doc.custom_merged_total else 0, currency=doc.currency) }}</b></td></tr>\n        </table>\n    </div>\n</div>\n\n<br>\n<div class=\"row\" style=\"margin-top: 20px;\">\n    <div class=\"col-xs-6\"></div>\n    <div class=\"col-xs-6\">\n        <div style=\"font-size: 16px; padding-top: 10px; border-top: 1px solid #d1d8dd;\">\n            <table style=\"width: 100%;\">\n                <tr>\n                    <td class=\"text-right text-muted\" style=\"width: 50%;\">COMBINED GRAND TOTAL</td>\n                    <td class=\"text-right\" style=\"width: 50%;\">\n                        <b>{{ frappe.utils.fmt_money((doc.grand_total | round) + ((doc.custom_merged_total | round) if doc.custom_merged_total else 0), currency=doc.currency) }}</b>\n                    </td>\n                </tr>\n            </table>\n        </div>\n    </div>\n</div>\n{% endif %}\n\n</div>\n",
