 "font_size": 14,
 "html": "<style>\n\t.print-format {\n\t\tmargin: 0 auto;\n\t\tpadding: 3mm;\n\t\twidth: 80mm;\n\t\tmax-width: 80mm;\n\t\tfont-size: 14pt;\n\t\tfont-family: Arial, Helvetica, sans-serif;\n\t}\n\n\t.print-format .waiter-slip-title {\n\t\tfont-size: 20pt;\n\t\tfont-weight: 700;\n\t\tmargin: 0 0 8px 0;\n\t\ttext-align: center;\n\t}\n\n\t.print-format .waiter-slip-meta {\n\t\tfont-size: 13pt;\n\t\tmargin: 0 0 8px 0;\n\t\tline-height: 1.4;\n\t}\n\n\t.print-format .waiter-slip-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-top: 8px;\n\t}\n\n\t.print-format .waiter-slip-table th,\n\t.print-format .waiter-slip-table td {\n\t\tfont-size: 14pt;\n\t\tpadding: 4px 2px;\n\t\tborder-bottom: 1px solid #000;\n\t}\n\n\t.print-format .waiter-slip-qty {\n\t\tfont-weight: 700;\n\t\ttext-align: right;\n\t}\n\n\t.print-format .cancel-line {\n\t\tcolor: #a00;\n\t}\n</style>\n\n<p class=\"text-center waiter-slip-title\">Waiter Order Slip</p>\n<p class=\"waiter-slip-meta\">\n\t<b>Invoice:</b> {{ doc.invoice }}<br>\n\t{% if doc.restaurant_table %}<b>Table:</b> {{ doc.restaurant_table }}<br>{% endif %}\n\t<b>Customer:</b> {{ doc.customer_name }}<br>\n\t{% if doc.order_no %}<b>Order:</b> {{ doc.order_no }}<br>{% endif %}\n\t{% if doc.waiter %}<b>Waiter:</b> {{ doc.waiter }}<br>{% endif %}\n\t<b>Date:</b> {{ doc.get_formatted(\"date\") }}<br>\n\t<b>Time:</b> {{ doc.get_formatted(\"time\") }}<br>\n</p>\n<hr>\n<table class=\"waiter-slip-table\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th width=\"70%\">Item</th>\n\t\t\t<th width=\"30%\" class=\"text-right\">Qty</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t{%- for item in doc.kot_items -%}\n\t\t{%- if item.cancelled_qty -%}\n\t\t<tr class=\"cancel-line\">\n\t\t\t<td>{{ item.item_name or item.item }}</td>\n\t\t\t<td class=\"waiter-slip-qty\">-{{ item.cancelled_qty }}</td>\n\t\t</tr>\n\t\t{%- else -%}\n\t\t<tr>\n\t\t\t<td>{{ item.item_name or item.item }}</td>\n\t\t\t<td class=\"waiter-slip-qty\">{{ item.quantity }}</td>\n\t\t</tr>\n\t\t{%- endif -%}\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n",
