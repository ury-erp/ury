{
  "general": [
    {
      "id": "language",
      "label": "Your Language",
      "type": "select",
      "optionsKey": "languages",
      "required": true,
      "validations": ["required"]
    },
    {
      "id": "country",
      "label": "Your Country",
      "type": "select",
      "optionsKey": "countries",
      "required": true,
      "validations": ["required"],
      "triggers": ["timezone", "currency", "chart_of_accounts"]
    },
    {
      "id": "timezone",
      "label": "Timezone",
      "type": "select",
      "optionsKey": "timezones",
      "required": true,
      "validations": ["required"]
    },
    {
      "id": "currency",
      "label": "Currency",
      "type": "select",
      "optionsKey": "currencies",
      "required": true,
      "validations": ["required"]
    }
  ],
  "company": [
    {
      "id": "company_name",
      "label": "Company Name",
      "type": "text",
      "placeholder": "e.g. URY Restaurant",
      "required": true,
      "validations": ["required", "minLength:3"],
      "triggers": ["company_abbr"]
    },
    {
      "id": "company_abbr",
      "label": "Company Abbreviation",
      "type": "text",
      "placeholder": "e.g. URY",
      "required": true,
      "validations": ["required", "maxLength:5"]
    },
    {
      "id": "chart_of_accounts",
      "label": "Chart of Accounts",
      "type": "select",
      "optionsKey": "charts_of_accounts",
      "required": false,
      "validations": []
    },
    {
      "id": "fy_start_date",
      "label": "Financial Year Begins On",
      "type": "date",
      "required": true,
      "validations": ["required"]
    }
  ],
  "installationTypes": [
    {
      "id": "minimal",
      "title": "Minimal Installation",
      "description": "Core Restaurant Operations, Point of Sale, Inventory Management, and Accounting."
    },
    {
      "id": "advanced",
      "title": "Advanced Installation",
      "description": "Includes Multi-Branch Management, CRM, Loyalty Programs, HR, and Advanced Analytics."
    }
  ]
}
