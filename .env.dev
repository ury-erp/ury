# ── URY Dashboard — Development Environment ───────────────
# Copy this file to .env and adjust values for local development.
# Used with: docker compose -f docker-compose.dev.yml up

# Frappe Backend URL (leave empty for demo mode)
NEXT_PUBLIC_FRAPPE_URL=

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production

# Socket.io Real-time Demo Server
NEXT_PUBLIC_SOCKET_PORT=3003

# Auto-refresh interval in milliseconds
NEXT_PUBLIC_REFRESH_INTERVAL=30000

# Default restaurant name shown in demo mode
NEXT_PUBLIC_RESTAURANT_NAME=URY Restaurant

# Currency symbol
NEXT_PUBLIC_CURRENCY=€

# Docker service ports (only change if you have port conflicts)
DASHBOARD_PORT=3000
POSTGRES_PORT=5432
ADMINER_PORT=8080
REDIS_PORT=6379
SOCKET_PORT=3003

# Database (used by Prisma inside the container)
DATABASE_URL=postgresql://ury:ury@postgres:5432/ury_dashboard
