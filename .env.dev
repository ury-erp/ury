# URY Dashboard — Development Environment Variables
# Copy this file to .env.local and adjust values for your setup

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://ury:ury_dev_2024@localhost:5432/ury_dashboard

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ── Frappe / ERPNext ──────────────────────────────────────
NEXT_PUBLIC_FRAPPE_URL=http://localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ── Realtime WebSocket ────────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── Feature Flags ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_POS=true
NEXT_PUBLIC_ENABLE_KITCHEN=true
NEXT_PUBLIC_ENABLE_RESERVATIONS=false

# ── Misc ──────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development
