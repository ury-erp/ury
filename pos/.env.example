# URY POS Environment Variables
# Copy this file to .env and fill in values

# AI Insights Configuration (optional — AI features are disabled if not set)
# Base URL for OpenAI-compatible API
VITE_AI_BASE_URL=https://api.puter.com/puterai/openai/v1/
# API key for the AI service
VITE_AI_API_KEY=your_api_key_here
# Default model to use
VITE_AI_MODEL=z-ai/glm-5.2
