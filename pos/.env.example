# URY POS Environment Variables
# Copy this file to .env and fill in values

# ── Frappe Backend ──────────────────────────────────────
# URL of your Frappe/ERPNext server with URY installed.
# Set to empty when MSW is enabled (MSW only intercepts same-origin requests).
VITE_FRAPPE_BASE_URL=http://localhost:8000

# ── MSW API Mocking ────────────────────────────────────
# Enable Mock Service Worker to intercept API requests and return mock data.
# When enabled, VITE_FRAPPE_BASE_URL must be empty.
# Useful for development and demos without a running Frappe backend.
VITE_MSW_ENABLED=false

# ── AI Insights Configuration ──────────────────────────
# Optional — AI features are disabled if not set.
# Base URL for OpenAI-compatible API
VITE_AI_BASE_URL=https://api.puter.com/puterai/openai/v1/
# API key for the AI service
VITE_AI_API_KEY=your_api_key_here
# Default model to use
VITE_AI_MODEL=z-ai/glm-5.2
