{
  "name": "ury-pos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "URY Restaurant POS — Point of Sale frontend for restaurant order management, menu management, dashboards, and reporting",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ury-erp/ury.git",
    "directory": "pos"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/ury/pos/ && yarn copy-html-entry",
    "copy-html-entry": "cp ../ury/public/pos/index.html ../ury/www/pos.html",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "check-all": "yarn type-check && yarn lint && yarn test && yarn build"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "frappe-js-sdk": "^1.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsrsasign": "^11.1.0",
    "lucide-react": "^0.525.0",
    "qz-tray": "^2.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.1",
    "react-toastify": "^11.0.5",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^24.0.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  }
}
